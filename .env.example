# Server Configuration
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vmcandles
DATABASE_SSL=false

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Flow.cl Payment Gateway
FLOW_API_KEY=your-flow-api-key
FLOW_SECRET_KEY=your-flow-secret-key
FLOW_ENVIRONMENT=sandbox
# For production: FLOW_ENVIRONMENT=production

# Frontend
# Local development:
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Production (Render):
# FRONTEND_URL=https://vm-ecommerce-frontend.onrender.com
# CORS_ORIGIN=https://vm-ecommerce-frontend.onrender.com

# AWS S3 (for audio/images)
AWS_S3_BUCKET=vmcandles-media
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# Email (SendGrid/SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=noreply@vmcandles.com
